# Root-level env file, read by Turborepo as a global dependency
# (see globalDependencies in turbo.json) so a change here correctly
# invalidates every app's cache. App-specific variables live in
# apps/web/.env.example and apps/api/.env.example — copy this alongside
# them as `.env` if you want a single shared NODE_ENV for local tooling.

NODE_ENV=development
