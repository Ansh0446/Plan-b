# Copy to `.env.local` for development.
# One typed loader (src/env.ts) reads these — never process.env elsewhere.
# Only NEXT_PUBLIC_* values belong here: everything in this file is
# bundled into client JavaScript. Server-only frontend secrets (if any are
# ever needed for route handlers) get their own non-public file — none
# exist yet in this milestone.

# Base URL the app is served from.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL of the NestJS API this app talks to.
NEXT_PUBLIC_API_URL=http://localhost:4000
