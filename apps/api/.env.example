# Copy to `.env` for local development. Real secrets are never committed —
# staging/production values live in the hosting platform's secret manager
# (Phase 1 §7). Live payment credentials never exist outside `production`.

# --- App ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Database (Prisma / PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/plan_b_dev?schema=public

# --- Auth (placeholders — wired when the auth module is built) ---
# JWT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Storage (Cloudflare R2 — wired when the resource pipeline is built) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# --- Payments (Razorpay — test keys only outside production) ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# --- Mail ---
# MAIL_FROM=
# MAIL_PROVIDER_API_KEY=

# --- Analytics ---
# POSTHOG_API_KEY=
