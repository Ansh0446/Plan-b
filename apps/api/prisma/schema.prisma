// =============================================================================
// PLAN B — Prisma Schema
// Milestone 2: Database Foundation
//
// This file is the direct implementation of docs/phase-2-database-bible.md
// (the locked Database Bible). Every model, enum, relation, index, and
// constraint below traces back to a specific section of that document —
// see the comment above each model. Nothing here contradicts it; where the
// Bible explicitly defers a decision to the Service layer (Section 14),
// this schema does NOT attempt to enforce it at the database level, and a
// comment says so.
//
// Conventions applied uniformly (Section 13):
//   - Primary keys: UUID, generated by the Prisma Client at the application
//     layer via `@default(uuid())` — never a database-generated sequence,
//     and never left to a Postgres default — so an entity's ID is known
//     before the write completes (Section 13's Resource Pipeline reasoning).
//   - Timestamps: every model carries `createdAt` + `updatedAt`; entities
//     named in Section 13 additionally carry action-specific timestamps
//     (`publishedAt`, `paidAt`, `refundedAt`, ...). All timestamps are
//     `timestamptz` (UTC), never pre-converted to local time (Section 13).
//   - Naming: table/column names are `snake_case` per Phase 1 §8, mapped
//     explicitly with `@@map` / `@map` so the Prisma Client itself stays
//     idiomatic `camelCase` TypeScript.
//   - Soft delete: applied exactly where Section 9 specifies it, and never
//     where Section 9 says hard delete (or "no delete path") is correct —
//     see the per-model comments.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

/// Section 1.1 / Section 2 (User) / Section 12 (Faculty, Creator).
/// CONTENT_OPS and ADMIN are both "elevated capability," not a different
/// kind of person (Section 1.1) — a role is a grant, never a new identity
/// table. CREATOR and FACULTY are reserved now (Section 1.6/Section 12) so
/// those future roles never require a User-table migration.
enum UserRole {
  STUDENT
  ADMIN
  CONTENT_OPS
  CREATOR
  FACULTY

  @@map("user_role")
}

/// Section 9 — User soft-delete strategy: "Soft (status: closed, credentials
/// invalidated)."
enum UserStatus {
  ACTIVE
  CLOSED

  @@map("user_status")
}

/// Section 2 (Course) — "active/coming-soon status," flipped explicitly by
/// Admin, never automatically.
enum CourseStatus {
  ACTIVE
  COMING_SOON

  @@map("course_status")
}

/// Section 2 (Branch) — identical shape to CourseStatus, kept as its own
/// enum rather than shared, since Branch and Course are independent
/// entities with independently-flipped status (never inferred from one
/// another).
enum BranchStatus {
  ACTIVE
  COMING_SOON

  @@map("branch_status")
}

/// Section 7.1 — Resource status enum, verbatim, including the reachability
/// rules noted in the Bible ("live" only reachable via an explicit Publish
/// action; "need_update" never auto-transitions to "hidden").
enum ResourceStatus {
  DRAFT
  SCHEDULED
  LIVE
  HIDDEN
  NEED_UPDATE
  ARCHIVED
  EXPIRED
  DELETED

  @@map("resource_status")
}

/// Section 7.2 — Order status. Per Section 5.1's narrative, a failed
/// Payment leaves the Order `PENDING` (a new Payment retries against the
/// same Order); `FAILED` is nonetheless included as a literal enum value
/// because Section 7.2 names it explicitly as part of the retry-loop
/// transition set. Which transitions a Service actually performs is
/// business logic (Section 14) and out of scope for this milestone.
enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED

  @@map("order_status")
}

/// Section 5.1 — Payment status: initiated → verified | failed.
enum PaymentStatus {
  INITIATED
  VERIFIED
  FAILED

  @@map("payment_status")
}

/// Section 2 (Coupon) — "discount type/value."
enum CouponDiscountType {
  PERCENTAGE
  FLAT_AMOUNT

  @@map("coupon_discount_type")
}

/// Section 7.3 — Coupon: "active (within its validity window) → expired
/// (automatic, date-based)."
enum CouponStatus {
  ACTIVE
  EXPIRED

  @@map("coupon_status")
}

/// Section 2 (Review) — "moderation status." Defaults to PENDING rather
/// than auto-approved, per Section 14's "never silently coerce/approve"
/// validation philosophy — the Service layer decides when v1's curated
/// reviews are inserted as pre-approved.
enum ReviewModerationStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("review_moderation_status")
}

/// Section 7.3 — Support Ticket: "open → in_progress → resolved (linear,
/// no skip-back once resolved without an explicit re-open action)."
enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED

  @@map("support_ticket_status")
}

/// Section 7.3 — Announcement: "scheduled → active → expired."
enum AnnouncementStatus {
  SCHEDULED
  ACTIVE
  EXPIRED

  @@map("announcement_status")
}

/// Section 2 (Announcement) — "target audience scope (all / specific
/// Branch / specific Course)."
enum AnnouncementAudienceScope {
  ALL
  COURSE
  BRANCH

  @@map("announcement_audience_scope")
}

/// Section 2 (Notification) — "type (receipt, version-update,
/// announcement-delivery, support-reply)."
enum NotificationType {
  RECEIPT
  VERSION_UPDATE
  ANNOUNCEMENT_DELIVERY
  SUPPORT_REPLY

  @@map("notification_type")
}

/// Section 2 (Notification) — "delivery channel (email/in-app)."
enum NotificationChannel {
  EMAIL
  IN_APP

  @@map("notification_channel")
}

// =============================================================================
// SECTION 1.1 / SECTION 2 — IDENTITY & ACCESS
// =============================================================================

/// Section 2 (User) — "the single identity behind every role the platform
/// will ever have." One table for every role (Section 1.1) — Admin,
/// Creator, and Faculty are `role` values on this same entity, never
/// separate identity tables.
model User {
  id String @id @default(uuid()) @db.Uuid

  email        String  @unique
  phone        String? @unique
  passwordHash String? @map("password_hash")
  googleId     String? @unique @map("google_id")

  name      String?
  avatarRef String? @map("avatar_ref")

  role   UserRole   @default(STUDENT)
  status UserStatus @default(ACTIVE)

  /// Section 2: "notification preferences." Kept as a flexible JSON blob
  /// (channel/type opt-in-out) rather than a rigid column set, since
  /// preference shape is expected to grow with NotificationType.
  notificationPreferences Json? @map("notification_preferences")

  /// Section 9 — soft delete: "status: closed, credentials invalidated."
  /// `closedAt` is the explicit timestamp companion to `status: CLOSED`.
  closedAt DateTime? @map("closed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // --- Relations: self-owned domains (Section 2) ---
  sessions          Session[]
  orders            Order[]
  reviews           Review[]
  downloadLogEntries DownloadLogEntry[]
  wishlistEntries   WishlistEntry[]
  bookmarks         Bookmark[]
  notifications     Notification[]
  supportTickets    SupportTicket[]         @relation("SupportTicketSubmitter")
  handledTickets    SupportTicket[]         @relation("SupportTicketHandler")
  auditLogEntries   AuditLogEntry[]

  // --- Relations: content-audit trail (Section 8) — this User acting as
  // creator/updater/deleter/publisher of admin-managed content. Named
  // relations are required since there are multiple FKs to User from the
  // same target models.
  resourcesCreated   Resource[] @relation("ResourceCreatedBy")
  resourcesOwned     Resource[] @relation("ResourceOwner")
  resourcesUpdated   Resource[] @relation("ResourceUpdatedBy")
  resourcesDeleted   Resource[] @relation("ResourceDeletedBy")
  resourcesPublished Resource[] @relation("ResourcePublishedBy")

  resourceVersionsCreated ResourceVersion[] @relation("ResourceVersionCreatedBy")

  subjectsCreated Subject[] @relation("SubjectCreatedBy")
  subjectsUpdated Subject[] @relation("SubjectUpdatedBy")
  subjectsDeleted Subject[] @relation("SubjectDeletedBy")

  branchesCreated Branch[] @relation("BranchCreatedBy")
  branchesUpdated Branch[] @relation("BranchUpdatedBy")
  branchesDeleted Branch[] @relation("BranchDeletedBy")

  coursesCreated Course[] @relation("CourseCreatedBy")
  coursesUpdated Course[] @relation("CourseUpdatedBy")
  coursesDeleted Course[] @relation("CourseDeletedBy")

  bundlesCreated Bundle[] @relation("BundleCreatedBy")
  bundlesUpdated Bundle[] @relation("BundleUpdatedBy")
  bundlesDeleted Bundle[] @relation("BundleDeletedBy")

  couponsCreated Coupon[] @relation("CouponCreatedBy")
  couponsUpdated Coupon[] @relation("CouponUpdatedBy")

  announcementsCreated Announcement[] @relation("AnnouncementCreatedBy")
  announcementsUpdated Announcement[] @relation("AnnouncementUpdatedBy")
  announcementsDeleted Announcement[] @relation("AnnouncementDeletedBy")

  branchSemesterSubjectsCreated BranchSemesterSubject[] @relation("BranchSemesterSubjectCreatedBy")
  resourceTypesCreated          ResourceType[]          @relation("ResourceTypeCreatedBy")

  @@index([role])
  @@index([status])
  @@map("users")
}

/// Section 2 (Session) — "represents one authenticated device/login
/// instance." Separates *who* (User) from *where/how currently logged in*
/// (Part 4 §11's per-device refresh-token model).
model Session {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash   String    @map("refresh_token_hash")
  deviceFingerprint  String?   @map("device_fingerprint")
  ipAddress          String?   @map("ip_address")
  userAgent          String?   @map("user_agent")
  lastActiveAt       DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(6)
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(6)

  /// Section 9 — "Hard delete on logout/expiry." `revokedAt` marks intent
  /// to remove before an actual hard-delete cleanup job runs; a Session
  /// row is never soft-delete-flagged as a permanent record.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// =============================================================================
// SECTION 1.2 / SECTION 2 — ACADEMIC STRUCTURE (the Academic Descent, Part 1)
// =============================================================================

/// Section 2 (University) — "top-level tenant boundary for the entire
/// academic tree." A second University is a new row, never a new table.
model University {
  id String @id @default(uuid()) @db.Uuid

  name      String  @unique
  shortCode String  @unique @map("short_code")

  /// Section 9 — soft delete: "Soft (archived), never hard" — University is
  /// a structural node other live entities point to.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  courses Course[]

  @@map("universities")
}

/// Section 2 (Course) — "establishes the student's top-level academic
/// identity." Seeded upfront (~30 rows), most `COMING_SOON`; flips to
/// `ACTIVE` by an explicit Admin action, never automatically.
model Course {
  id String @id @default(uuid()) @db.Uuid

  universityId String     @map("university_id") @db.Uuid
  university   University @relation(fields: [universityId], references: [id], onDelete: Restrict)

  name     String
  slug     String       @unique
  category String
  status   CourseStatus @default(COMING_SOON)

  /// Section 2: display order among the ~30 seeded tiles.
  displayOrder Int @default(0) @map("display_order")

  /// Section 9 — soft delete: "Soft (archived), never hard."
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  /// Section 8 — audit fields for this content-bearing entity.
  createdById String @map("created_by_id") @db.Uuid
  createdBy   User   @relation("CourseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String? @map("updated_by_id") @db.Uuid
  updatedBy   User?   @relation("CourseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById String? @map("deleted_by_id") @db.Uuid
  deletedBy   User?   @relation("CourseDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branches      Branch[]
  announcements Announcement[] @relation("AnnouncementAudienceCourse")
  coupons       Coupon[]       @relation("CouponApplicableCourse")

  @@index([universityId])
  @@index([status])
  @@map("courses")
}

/// Section 2 (Branch) — "narrows to peer-group/specialization identity."
/// Connects to Subjects only through the Branch–Semester–Subject Mapping,
/// never directly (Section 2/Section 3.1).
model Branch {
  id String @id @default(uuid()) @db.Uuid

  courseId String @map("course_id") @db.Uuid
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  name        String
  slug        String       @unique
  description String?
  status      BranchStatus @default(COMING_SOON)

  /// Section 2: "ordering among active branches is content-depth-driven";
  /// a manually-set or computed display order, not just creation time.
  displayOrder Int @default(0) @map("display_order")

  /// Section 9's sanctioned denormalization — cached count, refreshed
  /// async by a job triggered from the Mapping table, never inline
  /// (Section 14's consistency rule).
  subjectCount Int @default(0) @map("subject_count")

  /// Section 9 — soft delete: "Soft (archived), never hard."
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  /// Section 8 — audit fields.
  createdById String  @map("created_by_id") @db.Uuid
  createdBy   User    @relation("BranchCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String? @map("updated_by_id") @db.Uuid
  updatedBy   User?   @relation("BranchUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById String? @map("deleted_by_id") @db.Uuid
  deletedBy   User?   @relation("BranchDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branchSemesterSubjects BranchSemesterSubject[]
  canonicalForResources  Resource[]              @relation("ResourceCanonicalBranch")
  announcements          Announcement[]          @relation("AnnouncementAudienceBranch")

  @@index([courseId])
  @@index([status])
  @@map("branches")
}

/// Section 2 (Semester) — "a fixed, small lookup of temporal/lifecycle-
/// stage labels." Essentially static; connects to Branch/Subject only
/// through the Mapping entity.
model Semester {
  id String @id @default(uuid()) @db.Uuid

  label            String
  displayOrder     Int     @map("display_order")
  /// Section 2: "a flag distinguishing the numbered semesters from the
  /// parallel Placement track" — lets the frontend render the Placement
  /// Hub as visually separate rather than "Semester 7."
  isPlacementTrack Boolean @default(false) @map("is_placement_track")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branchSemesterSubjects BranchSemesterSubject[]

  @@map("semesters")
}

/// Section 2 (Subject) — "the single most important entity in the model."
/// Platform-level and deliberately independent of Branch (Section 15.6
/// Principle 1) — never duplicated for a second Branch that studies the
/// same material.
model Subject {
  id String @id @default(uuid()) @db.Uuid

  name        String
  code        String  @unique
  description String?

  /// Section 11 — "a small, optional array on Subject for known alternate
  /// names (e.g., 'DSA' alongside 'Data Structures & Algorithms')."
  aliases String[] @default([])

  /// Section 9's sanctioned denormalization — refreshed async, never the
  /// source of truth (the Resource table is).
  resourceCount Int @default(0) @map("resource_count")

  /// Section 9 — soft delete: "Soft (archived), never hard."
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  /// Section 8 — audit fields.
  createdById String  @map("created_by_id") @db.Uuid
  createdBy   User    @relation("SubjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String? @map("updated_by_id") @db.Uuid
  updatedBy   User?   @relation("SubjectUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById String? @map("deleted_by_id") @db.Uuid
  deletedBy   User?   @relation("SubjectDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branchSemesterSubjects BranchSemesterSubject[]
  resources              Resource[]
  bookmarks              Bookmark[]
  searchIndexEntries     SearchIndexEntry[]
  coupons                Coupon[]                @relation("CouponApplicableSubject")

  // Section 10 — "Subject.name + code (full-text)" powers keyword search.
  // A plain B-tree index on each is the Milestone-2 baseline; a GIN/
  // tsvector full-text index is a follow-up migration once real query
  // patterns are measured (Section 10's "no speculative indexing" rule).
  @@index([name])
  @@map("subjects")
}

/// Section 2 (Branch–Semester–Subject Mapping) — "the join entity that
/// actually implements the shared-subject model." One row = "this Subject
/// appears in this Branch, at this Semester." Nothing else (Section 2).
model BranchSemesterSubject {
  id String @id @default(uuid()) @db.Uuid

  branchId   String   @map("branch_id") @db.Uuid
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  semesterId String   @map("semester_id") @db.Uuid
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  subjectId  String   @map("subject_id") @db.Uuid
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  /// Section 2: "deleted (or archived) only if a curriculum genuinely
  /// drops a subject — extremely rare, always an explicit Admin action."
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  createdById String @map("created_by_id") @db.Uuid
  createdBy   User   @relation("BranchSemesterSubjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Section 14 — "a uniqueness constraint on the Branch–Semester–Subject
  // Mapping (Branch+Semester+Subject combination) prevents the exact
  // duplication Part 1 §3.1 was designed to eliminate."
  @@unique([branchId, semesterId, subjectId])
  // Section 10 — composite index for "the exact query the Subject
  // Selection screen runs" (Branch+Semester lookup).
  @@index([branchId, semesterId])
  @@index([subjectId])
  @@map("branch_semester_subjects")
}

// =============================================================================
// SECTION 1.3 / SECTION 2 / SECTION 4 — CONTENT & CATALOG
// =============================================================================

/// Section 2 (Resource Type) — lookup domain naming the *kind* of resource.
/// "New types are a data change" (Part 3 §21) — an insert, never a deploy.
model ResourceType {
  id String @id @default(uuid()) @db.Uuid

  name         String @unique
  slug         String @unique
  displayOrder Int    @default(0) @map("display_order")

  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  createdById String @map("created_by_id") @db.Uuid
  createdBy   User   @relation("ResourceTypeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  resources Resource[]

  @@map("resource_types")
}

/// Section 4 — "The Perfect Resource." The universal sellable unit; every
/// product on the platform, regardless of type, is one Resource
/// (Section 15.6 Principle 2 — never forked, Bundles wrap it).
model Resource {
  id String @id @default(uuid()) @db.Uuid

  // --- Identity ---
  title String
  slug  String @unique

  // --- Classification ---
  /// Nullable exclusively for Internship & Placement Hub items
  /// (Section 4 / Part 1 §4); required otherwise (enforced at the Service
  /// layer per Section 14 — not expressible as a DB-level conditional
  /// NOT NULL without a check constraint tied to ResourceType, which the
  /// Bible does not specify).
  subjectId      String?      @map("subject_id") @db.Uuid
  subject        Subject?     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  resourceTypeId String       @map("resource_type_id") @db.Uuid
  resourceType   ResourceType @relation(fields: [resourceTypeId], references: [id], onDelete: Restrict)

  /// Section 4: "a lightweight array of cross-cutting search terms —
  /// supplements, never replaces, hierarchy-based discovery."
  tags String[] @default([])

  // --- Metadata ---
  description String?
  pageCount   Int?    @map("page_count")
  fileSize    Int?    @map("file_size")
  language    String  @default("en")

  // --- SEO ---
  metaTitle          String? @map("meta_title")
  metaDescription    String? @map("meta_description")
  canonicalBranchId  String? @map("canonical_branch_id") @db.Uuid
  canonicalBranch    Branch? @relation("ResourceCanonicalBranch", fields: [canonicalBranchId], references: [id], onDelete: SetNull)

  // --- Preview ---
  /// Section 4: "typically 20–30%," stored per-resource, not hardcoded
  /// globally. Stored as an integer percentage (0–100).
  previewUnlockedPageRatio Int     @default(25) @map("preview_unlocked_page_ratio")
  previewAssetRef          String? @map("preview_asset_ref")
  thumbnailRef             String? @map("thumbnail_ref")

  // --- Versioning ---
  /// Section 4: "the only field on Resource itself that changes on every
  /// content update." Two distinct relations exist between Resource and
  /// ResourceVersion (this pointer, and the one-to-many version history
  /// below) — both must be explicitly named.
  currentVersionId String?          @map("current_version_id") @db.Uuid
  currentVersion   ResourceVersion? @relation("CurrentResourceVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  // --- Visibility & Status (Section 7.1) ---
  status        ResourceStatus @default(DRAFT)
  visibleFrom   DateTime?      @map("visible_from") @db.Timestamptz(6)
  visibleUntil  DateTime?      @map("visible_until") @db.Timestamptz(6)

  // --- Pricing ---
  /// Section 4: "a single, round-number value — set once per Resource,
  /// never per Branch." Section 4: "Explicitly excluded from Resource":
  /// no Branch-specific price override exists anywhere on this model.
  price         Decimal  @db.Decimal(10, 2)
  discountPrice Decimal? @map("discount_price") @db.Decimal(10, 2)

  // --- Ownership ---
  ownerId String? @map("owner_id") @db.Uuid
  owner   User?   @relation("ResourceOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  // --- Ranking ---
  /// Section 4: "periodically recomputed (not live) ... used only to break
  /// ties among equal keyword matches."
  searchRankBoost Float @default(0) @map("search_rank_boost")

  // --- Cached/Denormalized (Section 9's sanctioned exception) ---
  reviewAverage Decimal @default(0) @map("review_average") @db.Decimal(3, 2)
  reviewCount   Int     @default(0) @map("review_count")

  // --- Audit (Section 8) ---
  createdById String  @map("created_by_id") @db.Uuid
  createdBy   User    @relation("ResourceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String? @map("updated_by_id") @db.Uuid
  updatedBy   User?   @relation("ResourceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById String? @map("deleted_by_id") @db.Uuid
  deletedBy   User?   @relation("ResourceDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  /// Section 8/13: `published_at`, an explicit action-specific timestamp —
  /// "live" is only reachable through the Publish action (Section 7.1).
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  publishedById String?   @map("published_by_id") @db.Uuid
  publishedBy   User?     @relation("ResourcePublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)

  /// Section 9 — soft delete companion timestamp to `status: DELETED`.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // --- Relations ---
  versions           ResourceVersion[]    @relation("ResourceVersions")
  orderItems         OrderItem[]
  reviews            Review[]
  downloadLogEntries DownloadLogEntry[]
  wishlistEntries    WishlistEntry[]
  bookmarks          Bookmark[]
  bundleItems        BundleItem[]
  searchIndexEntries SearchIndexEntry[]

  // Section 10 — indexes for every named hot-path query.
  @@index([status])
  @@index([subjectId, resourceTypeId])
  @@index([resourceTypeId])
  @@index([canonicalBranchId])
  @@index([ownerId])
  @@index([title])
  @@map("resources")
}

/// Section 2 (Resource Version) — "tracks the history of a Resource's
/// underlying file across updates." Prior versions are never deleted, only
/// superseded (Section 6).
model ResourceVersion {
  id String @id @default(uuid()) @db.Uuid

  resourceId String   @map("resource_id") @db.Uuid
  resource   Resource @relation("ResourceVersions", fields: [resourceId], references: [id], onDelete: Restrict)

  versionNumber Int     @map("version_number")
  fileRef       String  @map("file_ref")
  changeNotes   String? @map("change_notes")
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)

  createdById String @map("created_by_id") @db.Uuid
  createdBy   User   @relation("ResourceVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Reverse side of Resource.currentVersion — a version may be "current"
  /// for at most one Resource. Kept as a list only because Prisma requires
  /// the relation to be declared on both sides; application logic (a
  /// future milestone) is what actually guarantees at-most-one.
  currentForResources Resource[] @relation("CurrentResourceVersion")

  downloadLogEntries DownloadLogEntry[]

  @@unique([resourceId, versionNumber])
  @@index([resourceId])
  @@map("resource_versions")
}

/// Section 2 (Bundle) — "a thin wrapper domain over existing Resources."
/// Never a new kind of sellable thing (Section 3.2 — no inheritance
/// anywhere); purchased through the same Order/Order Item mechanism.
model Bundle {
  id String @id @default(uuid()) @db.Uuid

  name        String
  slug        String  @unique
  description String?
  price       Decimal @db.Decimal(10, 2)

  /// Section 2: "a Bundle can be retired (hidden) without deleting the
  /// underlying Resources."
  isActive Boolean @default(true) @map("is_active")

  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  createdById String  @map("created_by_id") @db.Uuid
  createdBy   User    @relation("BundleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String? @map("updated_by_id") @db.Uuid
  updatedBy   User?   @relation("BundleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById String? @map("deleted_by_id") @db.Uuid
  deletedBy   User?   @relation("BundleDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  bundleItems BundleItem[]

  @@map("bundles")
}

/// Section 3.1/3.2 (Bundle Item) — the explicit join entity implementing
/// Bundle↔Resource, "mirroring Order Item's shape." Never a bare join
/// table, since it carries meaningful data (price at bundle time).
model BundleItem {
  id String @id @default(uuid()) @db.Uuid

  bundleId String @map("bundle_id") @db.Uuid
  bundle   Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  resourceId String   @map("resource_id") @db.Uuid
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  /// Section 3.2: "price-at-bundle-time" — captured, never a live lookup.
  priceAtBundleTime Decimal @map("price_at_bundle_time") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([bundleId, resourceId])
  @@index([resourceId])
  @@map("bundle_items")
}

/// Section 2 (Review) — carries a trust signal specific to one Resource.
model Review {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  resourceId String   @map("resource_id") @db.Uuid
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  rating  Int
  comment String?

  moderationStatus ReviewModerationStatus @default(PENDING) @map("moderation_status")

  /// Section 9 — soft delete: "A removed review should stop displaying
  /// without breaking the Resource's historical review_count math."
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([resourceId])
  @@index([moderationStatus])
  @@map("reviews")
}

/// Section 1.3/Section 11 (Search Index Entries) — "a derived, rebuildable
/// domain (not a source of truth) ... deleting and rebuilding it must
/// never lose real data." No audit/soft-delete fields, by design: this
/// table is safe to truncate and regenerate at any time.
model SearchIndexEntry {
  id String @id @default(uuid()) @db.Uuid

  resourceId String   @map("resource_id") @db.Uuid
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  subjectId String?  @map("subject_id") @db.Uuid
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  /// Denormalized, concatenated searchable text (title + description +
  /// tags + subject name/code/aliases) — the derived artifact this table
  /// exists to hold (Section 11).
  searchableText String @map("searchable_text")

  /// Section 4/Section 11: mirrors Resource.searchRankBoost at rebuild
  /// time — a tie-breaker only.
  rank Float @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([resourceId])
  @@index([subjectId])
  @@map("search_index_entries")
}

// =============================================================================
// SECTION 1.4 / SECTION 2 / SECTION 5 — COMMERCE
// =============================================================================

/// Section 2 (Order) — "the transaction record for one checkout attempt."
/// Independent of Payment (one Order may see multiple Payment attempts,
/// Section 5.3) and independent of ownership (a refund revokes access
/// without deleting purchase history, Section 5.2).
model Order {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  status OrderStatus @default(PENDING)

  subtotal       Decimal @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(10, 2)
  totalAmount    Decimal @map("total_amount") @db.Decimal(10, 2)

  couponId String?  @map("coupon_id") @db.Uuid
  coupon   Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)

  // --- Action-specific timestamps (Section 13) ---
  paidAt      DateTime? @map("paid_at") @db.Timestamptz(6)
  refundedAt  DateTime? @map("refunded_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  orderItems OrderItem[]
  payments   Payment[]
  invoice    Invoice?
  supportTickets SupportTicket[]

  // Section 10 — "Order.user_id + status: the Dashboard Purchases tab's
  // core query."
  @@index([userId, status])
  @@index([couponId])
  @@map("orders")
}

/// Section 2 (Order Item) — "one purchased line within an Order."
/// Captures the price *at time of purchase*, never a live lookup
/// (protects historical invoices from later price changes).
model OrderItem {
  id String @id @default(uuid()) @db.Uuid

  orderId String @map("order_id") @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  resourceId String   @map("resource_id") @db.Uuid
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  priceAtPurchase Decimal @map("price_at_purchase") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Section 14 names a uniqueness constraint on "(User, Resource,
  // Order-status-in-{pending,paid})" to prevent double-checkout. This is
  // NOT expressible here: Order Item deliberately does not carry User
  // directly (Section 3.2 — ownership is reached through Order, never
  // duplicated), and the condition depends on the *related* Order's
  // status, which a single-table Postgres constraint cannot express.
  // Section 14 itself is explicit that business rules "are enforced
  // exclusively in the Service layer... never in the database" — so the
  // double-checkout check belongs in the Orders service (a future
  // milestone), not as a schema constraint here.
  @@index([orderId])
  @@index([resourceId])
  @@map("order_items")
}

/// Section 2 (Payment) — "gateway-side truth about a payment attempt,"
/// deliberately separate from Order (Section 5.3) so retries never
/// invalidate the Order itself.
model Payment {
  id String @id @default(uuid()) @db.Uuid

  orderId String @map("order_id") @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  gatewayProvider       String  @default("razorpay") @map("gateway_provider")
  gatewayTransactionRef String? @unique @map("gateway_transaction_ref")
  gatewayOrderRef       String? @map("gateway_order_ref")

  /// Raw signature/webhook payload, kept for audit only — never re-parsed
  /// for business logic (Section 2).
  signature        String?
  rawWebhookPayload Json?   @map("raw_webhook_payload")

  status PaymentStatus @default(INITIATED)
  amount Decimal       @db.Decimal(10, 2)

  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  failedAt   DateTime? @map("failed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

/// Section 2 (Coupon) — "standalone, reusable discount rule," validated
/// fresh at checkout, never trusted from client state.
model Coupon {
  id String @id @default(uuid()) @db.Uuid

  code              String             @unique
  discountType      CouponDiscountType @map("discount_type")
  discountValue     Decimal            @map("discount_value") @db.Decimal(10, 2)

  validFrom  DateTime @map("valid_from") @db.Timestamptz(6)
  validUntil DateTime @map("valid_until") @db.Timestamptz(6)

  usageLimitGlobal  Int? @map("usage_limit_global")
  usageLimitPerUser Int? @map("usage_limit_per_user")
  usageCount        Int  @default(0) @map("usage_count")

  /// Section 2: "applicability scope (all resources / specific course /
  /// specific subject — optional future narrowing)." Both nullable; null
  /// on both means "all resources."
  applicableCourseId  String?  @map("applicable_course_id") @db.Uuid
  applicableCourse    Course?  @relation("CouponApplicableCourse", fields: [applicableCourseId], references: [id], onDelete: SetNull)
  applicableSubjectId String?  @map("applicable_subject_id") @db.Uuid
  applicableSubject   Subject? @relation("CouponApplicableSubject", fields: [applicableSubjectId], references: [id], onDelete: SetNull)

  status CouponStatus @default(ACTIVE)

  // Section 9 — "Hard delete acceptable if never used": no soft-delete
  // field is modeled here on purpose; an unused, expired Coupon is
  // removed as a real row, not flagged.
  createdById String  @map("created_by_id") @db.Uuid
  createdBy   User    @relation("CouponCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String? @map("updated_by_id") @db.Uuid
  updatedBy   User?   @relation("CouponUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  orders Order[]

  // Section 10 — "Coupon.code: checkout-time lookup must be near-instant,
  // and this field is also a natural uniqueness constraint" (covered by
  // @unique above, which Postgres backs with an index automatically).
  @@index([status])
  @@map("coupons")
}

/// Section 2 (Wishlist Entry) — "records purchase intent." Distinct from
/// Bookmark (Section 1.4 — conflating the two would corrupt both the
/// Dashboard UX and future recommendation signals).
model WishlistEntry {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  resourceId String   @map("resource_id") @db.Uuid
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, resourceId])
  @@index([userId])
  @@map("wishlist_entries")
}

/// Section 2 (Bookmark) — "records 'find this again' intent." Kept simple
/// as two nullable foreign keys (Subject, Resource), at most one populated
/// per row — enforced at the Service layer (Section 14), not as a DB
/// check constraint, since the Bible does not specify one.
model Bookmark {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId  String?   @map("subject_id") @db.Uuid
  subject    Subject?  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  resourceId String?   @map("resource_id") @db.Uuid
  resource   Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([subjectId])
  @@index([resourceId])
  @@map("bookmarks")
}

/// Section 2 (Invoice) — "the immutable financial document issued to a
/// student." Generated once, automatically, on `Order.status: paid`;
/// never edited afterward — a refund creates a separate record instead.
model Invoice {
  id String @id @default(uuid()) @db.Uuid

  orderId String @unique @map("order_id") @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  invoiceNumber String @unique @map("invoice_number")

  /// Section 2: "line items (mirroring Order Items at time of issuance)."
  lineItemsSnapshot Json @map("line_items_snapshot")

  subtotal    Decimal  @db.Decimal(10, 2)
  taxAmount   Decimal? @map("tax_amount") @db.Decimal(10, 2)
  totalAmount Decimal  @map("total_amount") @db.Decimal(10, 2)

  issuedAt DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("invoices")
}

/// Section 2 (Download Log Entry) — "records every signed-URL issuance,"
/// independent of Order — append-only (Section 9: "Never deleted").
model DownloadLogEntry {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  resourceId String   @map("resource_id") @db.Uuid
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  resourceVersionId String?          @map("resource_version_id") @db.Uuid
  resourceVersion   ResourceVersion? @relation(fields: [resourceVersionId], references: [id], onDelete: SetNull)

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  downloadedAt DateTime @default(now()) @map("downloaded_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Section 10 — "Download Log.user_id + resource_id: powers both the
  // ownership re-check and any future rate-limiting."
  @@index([userId, resourceId])
  @@index([resourceVersionId])
  @@map("download_log_entries")
}

// =============================================================================
// SECTION 1.5 / SECTION 2 — TRUST, COMMUNICATION & OPERATIONS
// =============================================================================

/// Section 2 (Notification) — "the single domain for anything delivered to
/// a User." References its triggering entity loosely, by type + ID
/// (Section 3.2 — a small, explicit set of possible target types, never an
/// open-ended "reference anything" pattern).
model Notification {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  channel NotificationChannel @default(IN_APP)

  title String
  body  String

  /// Loose reference to the triggering entity (Order, Resource,
  /// Announcement) — by type + ID, never a hard FK (Section 3.2).
  referenceType String? @map("reference_type")
  referenceId   String? @map("reference_id") @db.Uuid

  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Section 9 — "Hard delete acceptable after a retention window": no
  // soft-delete field is modeled; purge is a real DELETE run by a
  // scheduled job (a future milestone), not a status flag here.
  @@index([userId])
  @@index([referenceType, referenceId])
  @@map("notifications")
}

/// Section 2 (Announcement) — "platform-wide, admin-authored broadcast."
/// Fans out to Notification entries per targeted User at delivery time,
/// never stored as a giant User list on the Announcement itself.
model Announcement {
  id String @id @default(uuid()) @db.Uuid

  message       String
  audienceScope AnnouncementAudienceScope @default(ALL) @map("audience_scope")

  audienceCourseId String? @map("audience_course_id") @db.Uuid
  audienceCourse   Course? @relation("AnnouncementAudienceCourse", fields: [audienceCourseId], references: [id], onDelete: SetNull)
  audienceBranchId String? @map("audience_branch_id") @db.Uuid
  audienceBranch   Branch? @relation("AnnouncementAudienceBranch", fields: [audienceBranchId], references: [id], onDelete: SetNull)

  startAt  DateTime @map("start_at") @db.Timestamptz(6)
  expireAt DateTime @map("expire_at") @db.Timestamptz(6)

  status AnnouncementStatus @default(SCHEDULED)

  createdById String  @map("created_by_id") @db.Uuid
  createdBy   User    @relation("AnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String? @map("updated_by_id") @db.Uuid
  updatedBy   User?   @relation("AnnouncementUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById String? @map("deleted_by_id") @db.Uuid
  deletedBy   User?   @relation("AnnouncementDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@map("announcements")
}

/// Section 2 (Support Ticket) — "a lightweight queue of student
/// contact-form submissions." Guest submission is allowed (Section 2), so
/// `userId` is nullable with a `guestEmail` fallback.
model SupportTicket {
  id String @id @default(uuid()) @db.Uuid

  userId     String? @map("user_id") @db.Uuid
  user       User?   @relation("SupportTicketSubmitter", fields: [userId], references: [id], onDelete: SetNull)
  guestEmail String? @map("guest_email")

  subject String
  message String
  status  SupportTicketStatus @default(OPEN)

  orderId String? @map("order_id") @db.Uuid
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  handledById String? @map("handled_by_id") @db.Uuid
  handledBy   User?   @relation("SupportTicketHandler", fields: [handledById], references: [id], onDelete: SetNull)

  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([status])
  @@index([orderId])
  @@map("support_tickets")
}

/// Section 2 (Audit Log Entry) — "append-only record of every
/// state-changing Admin action." Loosely references any other entity by
/// type + ID, "never a hard foreign key, so an audit trail survives even
/// if the target row is later gone" (Section 2/Section 3.2).
model AuditLogEntry {
  id String @id @default(uuid()) @db.Uuid

  actorId String? @map("actor_id") @db.Uuid
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  /// Deliberately a free-form string, not an enum — Section 2: "this
  /// entity's shape is deliberately generic enough to cover any future
  /// action type."
  actionType String @map("action_type")

  targetType String  @map("target_type")
  targetId   String? @map("target_id")

  /// Section 8: "before/after change history... not a full diff." Kept as
  /// a compact JSON summary, not the entire row.
  beforeSummary Json? @map("before_summary")
  afterSummary  Json? @map("after_summary")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Section 10 — "Audit Log.target_type + target_id: investigating 'what
  // happened to entity X' is the primary query shape against this table."
  @@index([targetType, targetId])
  @@index([actorId])
  @@map("audit_log_entries")
}

